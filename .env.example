# Copiez ce fichier en `.env` puis remplissez les valeurs (le fichier .env n'est pas versionné).

# Assistant IA (Recherche & Découverte) — https://aistudio.google.com/app/apikey
REACT_APP_GEMINI_API_KEY=
# Modèle Gemini utilisé (facultatif, par défaut gemini-2.5-flash)
REACT_APP_GEMINI_MODEL=

# Photos des idées de plats (Découverte) — https://www.pexels.com/api/
REACT_APP_PEXELS_API_KEY=

# Envoi automatique de la liste de marché par e-mail (facultatif).
# URL de la Cloud Function `sendEmail` une fois déployée, par exemple :
# https://us-central1-cuisineafricaineapp.cloudfunctions.net/sendEmail
# Laissée vide, « E-mail à la famille » ouvre la messagerie de l'appareil.
REACT_APP_EMAIL_API_URL=
